# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — ignore real env files (may contain secrets), but keep the
# .example templates so setup instructions in the README actually work
.env*
!.env*.example

# vercel
.vercel

# Claude Code local session state (scheduled task locks, etc.)
.claude/

# Local history database (real scraped/analyzed data — personal, never commit)
/data/

# typescript
*.tsbuildinfo
next-env.d.ts
