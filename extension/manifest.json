{
  "manifest_version": 3,
  "name": "StealMySERP Crawler Bridge",
  "version": "1.0.0",
  "description": "Fetches real Google SERP data using your actual logged-in browser session, for the local StealMySERP app.",
  "key": "",
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["https://www.google.com/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://steal-my-serp.vercel.app/*",
      "https://steal-my-serp-git-main-rajkumaryhere-gmailcoms-projects.vercel.app/*"
    ]
  }
}
