OPENROUTER_API_KEY=

# Optional: have more than one OpenRouter account's free-tier quota to draw
# on? List all your keys here instead of OPENROUTER_API_KEY (comma-separated,
# no spaces needed). Only the first key is used until it hits its daily
# free-models limit, then the next one takes over — never round-robin, so it
# doesn't look like coordinated multi-account usage. See lib/llm/client.ts.
# OPENROUTER_API_KEYS=key1,key2

# Optional: route Google SERP requests through the local Python crawler
# bridge (crawler-service/) instead of the built-in direct-fetch scraper.
# See crawler-service/README.md.
# SERP_SOURCE=local-bridge
# SERP_BRIDGE_URL=http://localhost:8787

# Optional: route Google SERP requests through the StealMySERP Crawler
# Bridge Chrome extension (extension/) instead — uses your real, already
# logged-in browser session (no separate automated browser at all). See
# extension/README.md for setup and how to get the extension ID.
# NOTE: these NEXT_PUBLIC_ vars are baked in at build time — restart
# `npm run dev` after changing them.
# NEXT_PUBLIC_SERP_SOURCE=extension
# NEXT_PUBLIC_EXTENSION_ID=
